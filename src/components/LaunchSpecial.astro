            <th scope="col">Blinkist</th>
            <th scope="col">Day One</th>
            <th scope="col">Streaks</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">Meditation</th><td class="yes">●</td><td class="yes">●</td><td class="yes">●</td><td class="yes">●</td><td class="partial">○</td><td></td><td></td><td></td></tr>
          <tr><th scope="row">Breathwork</th><td class="yes">●</td><td class="yes">●</td><td class="yes">●</td><td class="yes">●</td><td class="partial">○</td><td></td><td></td><td></td></tr>
