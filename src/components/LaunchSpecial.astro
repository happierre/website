          <tr><th scope="row">Exercise</th><td class="yes">●</td><td class="partial">○</td><td class="partial">○</td><td class="partial">○</td><td class="partial">○</td><td></td><td></td><td></td></tr>
          <tr><th scope="row">Journaling</th><td class="yes">●</td><td class="partial">○</td><td class="partial">○</td><td class="partial">○</td><td class="yes">●</td><td></td><td class="yes">●</td><td></td></tr>
          <tr><th scope="row">Habit tracking</th><td class="yes">●</td><td class="partial">○</td><td class="partial">○</td><td></td><td class="yes">●</td><td></td><td></td><td class="yes">●</td></tr>
