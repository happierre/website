---
import '../styles/launch-special.css';
---

<section class="ls-section" id="sec-launch-special" aria-labelledby="ls-heading">
  <h2 class="ls-visually-hidden" id="ls-heading">Happierre in action</h2>
  <div class="ls-video-frame">
    <iframe
      class="ls-video ls-video--mobile"
      src="https://www.youtube-nocookie.com/embed/InRmhsLv2NQ?autoplay=1&mute=1&playsinline=1&controls=1&rel=0"
      title="Happierre mobile app video"
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
    <iframe
      class="ls-video ls-video--desktop"
      src="https://www.youtube-nocookie.com/embed/HCBZhlPYVIM?autoplay=1&mute=1&playsinline=1&controls=1&rel=0"
      title="Happierre desktop app video"
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>
</section>
