      <table class="ls-comparison">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col" class="ls-happierre-col">Happierre</th>
            <th scope="col">Headspace</th>
            <th scope="col">Calm</th>
            <th scope="col">Insight Timer</th>
            <th scope="col">Fabulous</th>
            <th scope="col">Blinkist</th>
            <th scope="col">Day One</th>
            <th scope="col">Streaks</th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">Meditation</th><td class="yes">●</td><td class="yes">●</td><td class="yes">●</td><td class="yes">●</td><td class="partial">○</td><td></td><td></td><td></td></tr>
