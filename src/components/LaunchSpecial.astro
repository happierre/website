---
import '../styles/launch-special.css';
---

<section class="ls-section" id="sec-launch-special" aria-labelledby="ls-heading">
  <div class="ls-container">
    <h2 class="ls-heading" id="ls-heading">one app for everything</h2>

    <div class="ls-table-frame">
      <span class="ls-scroll-cue" aria-hidden="true">›</span>
